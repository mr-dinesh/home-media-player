# Copy to .env and set real values. .env is gitignored — never commit it.
#
#   cp .env.example .env
#   ${EDITOR:-nano} .env
#
# Generate strong values with:  openssl rand -base64 24

# Used by Liquidsoap to authenticate as a source to Icecast.
# Must match on both sides — both read this same variable.
ICECAST_SOURCE_PASSWORD=

# Only used if you configure Icecast relays. Set it anyway.
ICECAST_RELAY_PASSWORD=

# Icecast admin UI at http://localhost:8000/admin
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=
